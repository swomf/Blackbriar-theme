#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "Usage: ./scripts/install [gtk|qt|cursor]"
  exit 1
}

post_install() {
  cat <<POSTEOF

  Blackbriar has been installed! Update your settings.

  In your favorite theme switcher tools:

      GTK: nwg-look        (equip Blackbriar-Dark)
      QT : kvantummanager  (equip BlackbriarDark)
         : qt6ct           (equip kvantum-dark)
  
  In hyprland's lua, for persistency:

      hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
      hl.env("XCURSOR_THEME", "Blackbriar")
      hl.env("XCURSOR_SIZE", "24")
      hl.env("HYPRCURSOR_THEME", "Blackbriar")
      hl.env("HYPRCURSOR_SIZE", "24")

  And for the current session:

      hyprctl setcursor Blackbriar 24
      gsettings set org.gnome.desktop.interface cursor-theme Blackbriar
      gsettings set org.gnome.desktop.interface cursor-size 24
POSTEOF
}

install_gtk() {
  "${repo_dir}/dist/Blackbriar-gtk-theme/install.sh" \
    --name Blackbriar \
    --color dark \
    --tweaks black \
    --libadwaita
}

install_qt() {
  local kvantum_dest="${XDG_CONFIG_HOME:-${HOME}/.config}/Kvantum/Blackbriar"
  local schemes_dest="${XDG_DATA_HOME:-${HOME}/.local/share}/color-schemes"

  mkdir -p "$kvantum_dest" "$schemes_dest"
  cp -a "${repo_dir}/dist/Blackbriar-qt-theme/Kvantum/Blackbriar/." \
    "$kvantum_dest/"
  cp -a "${repo_dir}/dist/Blackbriar-qt-theme/color-schemes/Blackbriar.colors" \
    "$schemes_dest/"

  echo "installed Kvantum theme to ${kvantum_dest}"
  echo "installed color scheme to ${schemes_dest}/Blackbriar.colors"
  echo "select BlackbriarDark with kvantummanager/qt6ct."
}

install_cursor() {
  local icons_dest="${HOME}/.local/share/icons"
  local cursor_dest="${icons_dest}/Blackbriar"

  mkdir -p "$cursor_dest"
  cp -a "${repo_dir}/dist/Blackbriar/." "$cursor_dest/"

  echo "installed cursor theme to ${cursor_dest}"
  echo "select Blackbriar and set XCURSOR_THEME=Blackbriar."
}

[[ $# -le 1 ]] || usage

case "${1:-}" in # cheaply catch --help or wrong args; kinda ugly setup here
"" | gtk | qt | cursor) ;;
*) usage ;;
esac

"${repo_dir}/scripts/build"

case "${1:-}" in
gtk)
  install_gtk
  ;;
qt)
  install_qt
  ;;
cursor)
  install_cursor
  ;;
*)
  install_gtk
  install_qt
  install_cursor
  ;;
esac

post_install

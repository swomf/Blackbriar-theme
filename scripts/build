#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dist_dir="${repo_dir}/dist"
gtk_upstream="${repo_dir}/upstream/graphite-gtk"
kde_upstream="${repo_dir}/upstream/graphite-kde"
cursor_source="${repo_dir}/src/cursors"

require_submodule() {
  local directory="$1"
  local label="$2"

  printf "checking for %s...\t\t" "$label"
  if ! git -C "$directory" rev-parse --verify HEAD >/dev/null 2>&1; then
    printf 'MISSING.\nRun:\n    git submodule update --init --recursive\n'
    exit 1
  fi
  printf "good\n"
}

require_submodule "$gtk_upstream" "Graphite GTK"
require_submodule "$kde_upstream" "Graphite KDE"

printf "regenerating Qt SVG constants...\t"
if make -C "${repo_dir}/src/cpp" --no-print-directory generate; then
  printf "good\n"
else
  printf "warning\nwarning: using the most recent checked-in Qt SVG constants instead\n"
fi

# refresh/some cheap copying
rm -rf "${dist_dir}/Blackbriar-gtk-theme" \
  "${dist_dir}/Blackbriar-qt-theme" \
  "${dist_dir}/Blackbriar"
cp -R "$gtk_upstream" "${dist_dir}/Blackbriar-gtk-theme"
mkdir -p "${dist_dir}/Blackbriar-qt-theme/Kvantum/Blackbriar"
mkdir -p "${dist_dir}/Blackbriar-qt-theme/color-schemes"
mkdir -p "${dist_dir}/Blackbriar"
cp -a "${cursor_source}/cursors" \
  "${cursor_source}/index.theme" \
  "${cursor_source}/UPSTREAM_REVISION" \
  "${dist_dir}/Blackbriar/"

# run python (cautious patching/string replacing/etc.)
{
  cd "$repo_dir"
  python3 -m src.main \
    "${dist_dir}/Blackbriar-gtk-theme" \
    "$kde_upstream" \
    "${dist_dir}/Blackbriar-qt-theme"
}

gtk_revision="$(git -C "$gtk_upstream" rev-parse HEAD)"
kde_revision="$(git -C "$kde_upstream" rev-parse HEAD)"

{
  echo "Graphite GTK: ${gtk_revision}"
  echo "Graphite KDE: ${kde_revision}"
} >"${dist_dir}/UPSTREAM_REVISIONS"

echo "Built Blackbriar into ${dist_dir}"
